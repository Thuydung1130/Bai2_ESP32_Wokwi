# MQTT source used by Mốc 2 collector
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_TOPIC=iotlab2/dung059/esp32/telemetry

# InfluxDB Cloud 2 (Cloud TSM), AWS us-east-1
INFLUX_URL=https://us-east-1-1.aws.cloud2.influxdata.com
INFLUX_ORG=REPLACE_WITH_YOUR_CLOUD_ORGANIZATION
INFLUX_BUCKET=iot_raw
INFLUX_TOKEN=REPLACE_WITH_YOUR_CLOUD_API_TOKEN

# Raw measurement written by collector
INFLUX_MEASUREMENT=sensor_raw
